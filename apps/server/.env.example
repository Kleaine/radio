# AI 音乐电台 — 环境变量
# 复制此文件为 .env 并填入实际 Key

# ── 服务器配置 ──
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
JWT_SECRET=radio-dj-secret-2026

# ── 豆包 LLM ──
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-lite-128k

# ── QQ 音乐（选填，不填走 Mock 模式）──
QQ_MUSIC_COOKIE=

# ── 天气（选填，不填走免费的 Wttr.in）──
OPENWEATHER_API_KEY=
CITY=Beijing

# ── 飞书 OAuth（选填，不填走 Mock 模式）──
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://localhost:3000/api/feishu/callback

# ── TTS 服务（选填）──
TTS_SERVICE_URL=http://127.0.0.1:8008
